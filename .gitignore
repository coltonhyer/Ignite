# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which can generally be ignored
*.pdb
*.ilk
*.exp
*.lib

# SQLite database and transaction logs
ignite.db*
*.db
*.db-shm
*.db-wal

# Local configuration and process output
.env
.env.*
!.env.example
*.log
*.pid

# Frontend build output
dist/
node_modules/

# Backup and patch files
*.orig
*.patch
*.rej

# AI Assistant Tools
.claude/
